root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_size              = 4
indent_style             = tab
insert_final_newline     = true
max_line_length          = 120
trim_trailing_whitespace = true

[*.sh]
space_redirects    = true
switch_case_indent = true

[*.{json,jsonc}]
indent_size  = 2

[*.{yml,yaml}]
indent_size  = 2
indent_style = space
